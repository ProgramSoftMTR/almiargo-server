# Servidor
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Seguridad
JWT_SECRET=

# Google OAuth (client ID de tipo Web application)
GOOGLE_CLIENT_ID=
# Client ID de tipo Android, si el token nativo llega con ese audience
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=

# Administradores (correos separados por coma)
ADMIN_EMAILS=

# Persistencia: firestore (produccion) o memory (desarrollo local).
# Si FIREBASE_SERVICE_ACCOUNT esta definido, el default es firestore.
STORE_DRIVER=firestore

# JSON completo de la service account de Firebase (una sola linea,
# con los \n de private_key escapados). Se parsea con JSON.parse + cert().
FIREBASE_SERVICE_ACCOUNT=

# PostgreSQL (alternativo, no usado con Firestore)
DATABASE_URL=
PGSSL=true

# Rendimiento
TICK_RATE=20
SNAPSHOT_RATE=10
AOI_RADIUS=18
MAX_PLAYERS=500
