# ── Servidor ──────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Secreto para firmar tokens de sesión (CAMBIA en producción)
JWT_SECRET=dev-only-change-me

# ── Autenticación OAuth (sólo WebSocket) ───────────────────
# Client ID de tipo "Web application" de Google Cloud. La app Android usa este
# mismo ID como serverClientId y el servidor lo usa como audience del JWT.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Correos con permisos de administrador (lista separada por comas). El personaje
# de estos correos se crea como "ChiwiADMIN", se guarda con isAdmin: true y su
# nombre se pinta en morado (#800080). Si se omite, se usa el correo por defecto
# definido en server/src/admin.js.
ADMIN_EMAILS=alejoargumedo.edu@gmail.com

# Persistencia: "json" (cero configuración) | "postgres" | "memory"
STORE_DRIVER=json
DATA_DIR=./data

# Solo si STORE_DRIVER=postgres
DATABASE_URL=postgres://rucoy:rucoy@localhost:5432/rucoy
PGSSL=false

# Ritmo del servidor
TICK_RATE=20
SNAPSHOT_RATE=10
AOI_RADIUS=20
MAX_PLAYERS=500

# ── Cliente (Vite) ───────────────────────────────────────
# El build inyecta el endpoint; el jugador no configura nada.
VITE_SERVER_URL=wss://tu-dominio.com
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

