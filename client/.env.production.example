# Endpoint que se incrusta en el APK/web al compilar.
# El jugador nunca escribe esta URL: el cliente deriva de aquí la conexión
# WebSocket y el login OAuth viaja en el primer payload (sin HTTP previo).
#
# Puede ser una URL base o el endpoint WebSocket completo:
#   https://juego.midominio.com
#   https://juego.midominio.com/ws
#   wss://juego.midominio.com/ws
#   http://192.168.1.59:8080
#
# Para usarlo, copia este archivo como client/.env.production y cambia los valores.
VITE_SERVER_URL=https://juego.midominio.com

# Client ID de tipo "Web application" de Google Cloud. Debe coincidir con
# GOOGLE_CLIENT_ID del servidor y estar vinculado a la app Android
# (package técnico com.rucoylike.game + huella SHA-1 del keystore de release).
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
