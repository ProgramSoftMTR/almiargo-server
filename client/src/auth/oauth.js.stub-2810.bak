export const googleOAuthConfigured = false;

// Almacenamiento local para credenciales temporales (solo sesión actual)
const LOCAL_STORAGE_KEY = 'rucoy.credentials';

export function saveCredentials(username, password) {
  localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify({ username, password }));
}

export function getSavedCredentials() {
  const data = localStorage.getItem(LOCAL_STORAGE_KEY);
  return data ? JSON.parse(data) : null;
}

export function clearCredentials() {
  localStorage.removeItem(LOCAL_STORAGE_KEY);
}

// Payloads para WebSocket
export function buildLoginPayload(username, password) {
  return { type: 'login', username, password };
}

export function buildRegisterPayload(username, password) {
  return { type: 'register', username, password };
}